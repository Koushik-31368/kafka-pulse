# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=user-events
KAFKA_CONSUMER_GROUP=pipeline-consumer-group

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5433
DB_NAME=pipeline_db
DB_USER=pipeline_user
DB_PASSWORD=pipeline_pass

# Producer Configuration
PRODUCER_INTERVAL_SECONDS=1       # default interval (overridden by --rate flag)

# Consumer Configuration
CONSUMER_BATCH_SIZE=20            # events per DB transaction (higher = more throughput)
HIGH_VALUE_THRESHOLD=200.0        # USD amount above which events are flagged "high value"
DLQ_PATH=dlq.jsonl                # dead-letter queue file path

# Monitor Configuration
MONITOR_REFRESH_SECONDS=3         # dashboard refresh interval in seconds
